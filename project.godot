; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hacker Empire"
config/description="Isometric cyberpunk hacker tycoon RPG. All hacking is fictional and self-contained."
config/version="0.8.0"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.031, 0.043, 0.078, 1)

[autoload]

SaveManager="*res://scripts/save/save_manager.gd"
PlayerManager="*res://scripts/player/player_manager.gd"
EconomyManager="*res://scripts/economy/economy_manager.gd"
ProgressionManager="*res://scripts/progression/progression_manager.gd"
ReputationManager="*res://scripts/reputation/reputation_manager.gd"
HardwareManager="*res://scripts/hardware/hardware_manager.gd"
SkillManager="*res://scripts/skills/skill_manager.gd"
ContractManager="*res://scripts/contracts/contract_manager.gd"
OrganizationManager="*res://scripts/organization/organization_manager.gd"
EmployeeManager="*res://scripts/employees/employee_manager.gd"
ResearchManager="*res://scripts/research/research_manager.gd"
ProductManager="*res://scripts/research/product_manager.gd"
EventManager="*res://scripts/events/event_manager.gd"
StoryManager="*res://scripts/story/story_manager.gd"
MailManager="*res://scripts/desktop/mail_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

