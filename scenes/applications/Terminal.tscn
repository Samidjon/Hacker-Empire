[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/applications/terminal/terminal.gd" id="1"]

[sub_resource type="SystemFont" id="mono"]
font_names = PackedStringArray("Consolas", "Cascadia Mono", "Courier New", "monospace")

[sub_resource type="StyleBoxEmpty" id="flat_input"]

[node name="Terminal" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Output" type="RichTextLabel" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
theme_override_fonts/normal_font = SubResource("mono")
theme_override_font_sizes/normal_font_size = 17
scroll_following = true

[node name="InputRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PromptLabel" type="Label" parent="InputRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 1, 0.612, 1)
theme_override_fonts/font = SubResource("mono")
theme_override_font_sizes/font_size = 17
text = "user@empire:~$"

[node name="CommandInput" type="LineEdit" parent="InputRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_fonts/font = SubResource("mono")
theme_override_font_sizes/font_size = 17
theme_override_styles/normal = SubResource("flat_input")
theme_override_styles/focus = SubResource("flat_input")
placeholder_text = "type a command"
caret_blink = true
