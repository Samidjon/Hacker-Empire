[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/applications/contracts_app.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/contracts/MissionRunner.tscn" id="2"]

[node name="ContractsApp" type="VBoxContainer"]
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="Tabs" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BoardTabButton" type="Button" parent="Tabs"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "Board"

[node name="ActiveTabButton" type="Button" parent="Tabs"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "Active"

[node name="HistoryTabButton" type="Button" parent="Tabs"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallButton"
toggle_mode = true
text = "History"

[node name="ContractStatsLabel" type="Label" parent="Tabs"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
text = "Completed 0   Failed 0"
horizontal_alignment = 2

[node name="BoardView" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="Left" type="VBoxContainer" parent="BoardView"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="OfferList" type="ItemList" parent="BoardView/Left"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_vertical = 3

[node name="RefreshBoardButton" type="Button" parent="BoardView/Left"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Replace every offer on the board"
theme_type_variation = &"SmallButton"
text = "New Offers"

[node name="Details" type="PanelContainer" parent="BoardView"]
layout_mode = 2
size_flags_horizontal = 3

[node name="VBox" type="VBoxContainer" parent="BoardView/Details"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="OfferTitle" type="Label" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "No offers"
autowrap_mode = 3

[node name="OfferMeta" type="Label" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"

[node name="OfferDescription" type="Label" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
autowrap_mode = 3

[node name="OfferFacts" type="RichTextLabel" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0

[node name="RequirementLabel" type="Label" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.271, 0.376, 1)
autowrap_mode = 3

[node name="AcceptButton" type="Button" parent="BoardView/Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Accept Contract"

[node name="ActiveView" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="NoActiveLabel" type="Label" parent="ActiveView"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "No contract in progress. Pick one from the Board."

[node name="MissionRunner" parent="ActiveView" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="HistoryView" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="ContractHistoryTable" type="RichTextLabel" parent="HistoryView"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
