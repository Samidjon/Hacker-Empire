[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/applications/marketplace_app.gd" id="1"]

[node name="Marketplace" type="HBoxContainer"]
theme_override_constants/separation = 14
script = ExtResource("1")

[node name="MarketCategoryList" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(190, 0)
layout_mode = 2

[node name="MarketItemList" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2

[node name="Details" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="VBox" type="VBoxContainer" parent="Details"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MarketBalanceLabel" type="Label" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 1, 0.612, 1)
text = "Balance  $0"
horizontal_alignment = 2

[node name="MarketItemTitle" type="Label" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Nothing selected"
autowrap_mode = 3

[node name="MarketItemMeta" type="Label" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"

[node name="MarketItemDescription" type="Label" parent="Details/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
autowrap_mode = 3

[node name="MarketItemFacts" type="RichTextLabel" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0

[node name="MarketBlockerLabel" type="Label" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.271, 0.376, 1)
autowrap_mode = 3

[node name="BuyButton" type="Button" parent="Details/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Buy"
