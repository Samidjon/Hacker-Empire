[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/applications/file_manager.gd" id="1"]

[node name="FileManager" type="VBoxContainer"]
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="PathBar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="UpButton" type="Button" parent="PathBar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Parent folder"
theme_type_variation = &"SmallButton"
text = "Up"

[node name="HomeButton" type="Button" parent="PathBar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Home folder"
theme_type_variation = &"SmallButton"
text = "Home"

[node name="PathLabel" type="Label" parent="PathBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0, 0.898, 1, 1)
text = "/"
clip_text = true

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="EntryList" type="ItemList" parent="Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 0)
layout_mode = 2

[node name="Preview" type="VBoxContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PreviewTitle" type="Label" parent="Body/Preview"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "No file selected"

[node name="PreviewText" type="RichTextLabel" parent="Body/Preview"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
