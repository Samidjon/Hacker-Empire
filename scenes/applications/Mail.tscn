[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/applications/mail_app.gd" id="1"]

[node name="Mail" type="HBoxContainer"]
theme_override_constants/separation = 14
script = ExtResource("1")

[node name="MessageList" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="Reader" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="SubjectLabel" type="Label" parent="Reader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Inbox"
autowrap_mode = 3

[node name="MetaLabel" type="Label" parent="Reader"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "0 message(s)"

[node name="BodyText" type="RichTextLabel" parent="Reader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 0
