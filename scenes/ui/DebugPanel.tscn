[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/debug_panel.gd" id="1"]

[node name="DebugPanel" type="PanelContainer"]
custom_minimum_size = Vector2(300, 0)
size_flags_vertical = 0
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.69, 0.125, 1)
text = "DEV TOOLS"

[node name="Note" type="Label" parent="VBox"]
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Debug builds only. Grants XP, money and reputation until contracts arrive in MVP 4."
autowrap_mode = 3

[node name="ButtonList" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
