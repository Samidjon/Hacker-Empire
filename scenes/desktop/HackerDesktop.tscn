[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/desktop/hacker_desktop.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/NeonBackground.tscn" id="2"]

[node name="HackerDesktop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Wallpaper" parent="." instance=ExtResource("2")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Main" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Launcher" type="PanelContainer" parent="Margin/Layout/Main"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Margin/Layout/Main/Launcher"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="Label" parent="Margin/Layout/Main/Launcher/VBox"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "APPLICATIONS"

[node name="IconGrid" type="GridContainer" parent="Margin/Layout/Main/Launcher/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
columns = 2

[node name="WindowArea" type="Control" parent="Margin/Layout/Main"]
unique_name_in_owner = true
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Taskbar" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="HBox" type="HBoxContainer" parent="Margin/Layout/Taskbar"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="OsLabel" type="Label" parent="Margin/Layout/Taskbar/HBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "EMPIRE//OS"

[node name="TaskList" type="HBoxContainer" parent="Margin/Layout/Taskbar/HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TaskbarMoneyLabel" type="Label" parent="Margin/Layout/Taskbar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0, 1, 0.612, 1)
text = "$0"

[node name="ClockLabel" type="Label" parent="Margin/Layout/Taskbar/HBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "00:00"

[node name="LogOffButton" type="Button" parent="Margin/Layout/Taskbar/HBox"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SmallButton"
text = "Log Off (Esc)"

[node name="ClockTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 5.0
autostart = true
